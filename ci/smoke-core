    tail -n 50 "$network_output" || true
    [ "$network_rc" -eq 0 ] || die "hosty -d failed with exit $network_rc"

    # Workspace runs prefer lists/*.sources; installed copies download defaults.
    if ! grep -qF "using local sources from" "$network_output" &&
        ! grep -qF "downloading default sources" "$network_output"; then
        die "expected local or default sources message in network debug run"
