# Build a hosty copy whose whitelist and whitelist sources each hold one active
# and one inactive entry against the blacklist source.
setup_clean_lists() {
    clean_lists_dir=$1
    rm -rf "$clean_lists_dir"
    mkdir -p "$clean_lists_dir/lists" "$clean_lists_dir/sources"
    cp "$HOSTY" "$clean_lists_dir/hosty"
    chmod 755 "$clean_lists_dir/hosty"
    printf '%s\n' ads.example.test shared.example.test > "$clean_lists_dir/sources/bl"
    printf '%s\n' shared.example.test > "$clean_lists_dir/sources/wl-active"
    printf '%s\n' unused.example.test > "$clean_lists_dir/sources/wl-inactive"
    printf 'file://%s\n' "$clean_lists_dir/sources/bl" > "$clean_lists_dir/lists/blacklist.sources"
    printf '%s\n' shared.example.test inactive.example.test > "$clean_lists_dir/lists/whitelist"
    printf 'file://%s\n' "$clean_lists_dir/sources/wl-active" "$clean_lists_dir/sources/wl-inactive" \
        > "$clean_lists_dir/lists/whitelist.sources"
    cp "$clean_lists_dir/lists/whitelist" "$clean_lists_dir/whitelist.orig"
    cp "$clean_lists_dir/lists/whitelist.sources" "$clean_lists_dir/whitelist.sources.orig"
}

run_clean_write_failures_offline() {
    log "-- whitelist cleanup write failures --"
    as_root rm -rf /etc/hosty
    failures_dir="$LOG_DIR/modes-test"
    failures_bin=$(mktemp -d) || die "mktemp -d failed"
    # hosty keeps whitelist backups in TMPDIR; an isolated one exposes leftovers.
    failures_tmp=$(mktemp -d) || die "mktemp -d failed"
    real_cat=$(command -v cat)
    # Fail cat for arguments matching any glob in HOSTY_FAKE_CAT_FAIL, or whose
    # file name matches HOSTY_FAKE_CAT_FAIL_NAME; a failed "cat src > dst"
    # truncates dst like a real mid-write failure would.
    cat > "$failures_bin/cat" << EOF_CAT
#!/bin/sh
set -f
for cat_arg in "\$@"; do
    case \${cat_arg##*/} in
        \${HOSTY_FAKE_CAT_FAIL_NAME:-/}) exit 1 ;;
    esac
    for cat_pattern in \${HOSTY_FAKE_CAT_FAIL:-}; do
        case \$cat_arg in
            \$cat_pattern) exit 1 ;;
        esac
    done
done
exec "$real_cat" "\$@"
EOF_CAT
    chmod +x "$failures_bin/cat"

    setup_clean_lists "$failures_dir"
    expect_failure "$LOG_DIR/clean-write-whitelist.out" \
        "failed to write $failures_dir/lists/whitelist; left unchanged." \
        env "PATH=$failures_bin:$PATH" TMPDIR="$failures_tmp" HOSTY_FAKE_CAT_FAIL='*/wl_clean_tmp' \
        "$failures_dir/hosty" -c
    cmp "$failures_dir/whitelist.orig" "$failures_dir/lists/whitelist" ||
        die "failed whitelist write should restore the original contents"
    assert_file_contains "$LOG_DIR/clean-write-whitelist.out" "whitelist cleanup completed with skipped items."
    assert_file_not_contains "$failures_dir/lists/whitelist.sources" "wl-inactive" \
        "other whitelist files should still be cleaned"
    assert_no_extra_files "$failures_tmp" "" "restored whitelist backups should be removed"

    setup_clean_lists "$failures_dir"
    expect_failure "$LOG_DIR/clean-write-sources.out" \
        "failed to write $failures_dir/lists/whitelist.sources; left unchanged." \
        env "PATH=$failures_bin:$PATH" TMPDIR="$failures_tmp" HOSTY_FAKE_CAT_FAIL='*/src_clean_tmp' \
        "$failures_dir/hosty" -c
    cmp "$failures_dir/whitelist.sources.orig" "$failures_dir/lists/whitelist.sources" ||
        die "failed source list write should restore the original contents"
    assert_file_not_contains "$failures_dir/lists/whitelist" "inactive.example.test" \
        "other whitelist files should still be cleaned"
    assert_no_extra_files "$failures_tmp" "" "successful whitelist backups should be removed"

    setup_clean_lists "$failures_dir"
    expect_failure "$LOG_DIR/clean-write-backup.out" \
        "failed to write $failures_dir/lists/whitelist; left unchanged." \
        env "PATH=$failures_bin:$PATH" TMPDIR="$failures_tmp" HOSTY_FAKE_CAT_FAIL='*/lists/whitelist' \
        "$failures_dir/hosty" -c
    cmp "$failures_dir/whitelist.orig" "$failures_dir/lists/whitelist" ||
        die "a whitelist that cannot be backed up should not be written"
    assert_no_extra_files "$failures_tmp" "" "incomplete whitelist backups should be removed"

    setup_clean_lists "$failures_dir"
    expect_failure "$LOG_DIR/clean-write-restore.out" \
        "failed to write $failures_dir/lists/whitelist; original contents kept at " \
        env "PATH=$failures_bin:$PATH" TMPDIR="$failures_tmp" HOSTY_FAKE_CAT_FAIL='*/wl_clean_tmp' \
        HOSTY_FAKE_CAT_FAIL_NAME='tmp.*' "$failures_dir/hosty" -c
    assert_file_not_contains "$LOG_DIR/clean-write-restore.out" "left unchanged" \
        "an unrestored file must not be reported as unchanged"
    failures_backup=$(sed -n 's/.*original contents kept at //p' "$LOG_DIR/clean-write-restore.out")
    case $failures_backup in
        "$failures_tmp"/*) ;;
        *) die "the whitelist backup should be kept in TMPDIR, not $failures_backup" ;;
    esac
    cmp "$failures_dir/whitelist.orig" "$failures_backup" ||
        die "the kept backup should hold the original whitelist"

    rm -rf "$failures_bin" "$failures_tmp"
    setup_direct_fixtures
}

# Run a command as an unprivileged user so file permissions apply. As root,
# use util-linux setpriv, or su where setpriv lacks --reuid (BusyBox).
UNPRIVILEGED_TOOL=""

can_run_unprivileged() {
    if [ "$(id -u)" -ne 0 ]; then
        UNPRIVILEGED_TOOL=none
    elif setpriv --reuid=65534 --regid=65534 --clear-groups true > /dev/null 2>&1; then
        UNPRIVILEGED_TOOL=setpriv
    elif su -s /bin/sh nobody -c true > /dev/null 2>&1; then
        UNPRIVILEGED_TOOL=su
    else
        return 1
    fi
}

run_unprivileged() {
    case $UNPRIVILEGED_TOOL in
        none) "$@" ;;
        setpriv) setpriv --reuid=65534 --regid=65534 --clear-groups "$@" ;;
        su)
            # BusyBox su parses options after -c, so pass one quoted command.
            run_unprivileged_command='exec'
            for run_unprivileged_arg in "$@"; do
                run_unprivileged_arg=$(printf '%s' "$run_unprivileged_arg" | sed "s/'/'\\\\''/g")
                run_unprivileged_command="$run_unprivileged_command '$run_unprivileged_arg'"
            done
            su -s /bin/sh nobody -c "$run_unprivileged_command"
            ;;
        *) die "can_run_unprivileged must succeed before run_unprivileged" ;;
    esac
}

run_unwritable_whitelists_offline() {
    if ! can_run_unprivileged; then
        log "no way to drop root privileges; skip unwritable whitelist tests"
        return 0
    fi

    log "-- whitelist cleanup skips unwritable files --"
    as_root rm -rf /etc/hosty
    unwritable_root=$(mktemp -d) || die "mktemp -d failed"
    unwritable_dir="$unwritable_root/unprivileged-test"
    setup_clean_lists "$unwritable_dir"
    # The unprivileged user must reach the fixtures whatever the umask.
    chmod -R a+rX "$unwritable_root"
    chmod 444 "$unwritable_dir/lists/whitelist" "$unwritable_dir/lists/whitelist.sources"
    unwritable_output="$unwritable_root/clean.out"
    if run_unprivileged "$unwritable_dir/hosty" -c > "$unwritable_output" 2>&1; then
        cat "$unwritable_output"
        rm -rf "$unwritable_root"
        die "cleanup of unwritable whitelists should report failure"
